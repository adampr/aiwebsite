#!/usr/bin/env bash
# Host-local pre-commit checks (run FIRST by the template-rendered pre-commit,
# @aicompany/core §16 v1.6). Holds aiwebsite's secrets gate, formerly Gate 1
# of the hand-owned hook. Rule source: CLAUDE.md "Never commit secrets" /
# .cursor/rules/no-secrets.mdc.
#
# Bypass (false positive in the scan ONLY — never to commit a real secret):
#   SECRETS_OK=1 git commit ...

if [ -z "${SECRETS_OK:-}" ]; then
  staged_new=$(git diff --cached --name-only --diff-filter=ACMR)

  # 1a. Forbidden filenames: any dotenv file except .env.example, and
  # private-key material. (deploy/site-deploy.env is not a dotfile and is
  # intentionally tracked — it must stay secret-free.)
  bad_files=$(printf '%s\n' "$staged_new" \
    | grep -E '(^|/)\.env(\..+)?$|\.(pem|p12|pfx|key)$|(^|/)id_(rsa|ed25519|ecdsa)$' \
    | grep -vE '(^|/)\.env\.example$')
  if [ -n "$bad_files" ]; then
    cat >&2 <<MSG

BLOCKED: secrets gate — env/key files must never be committed.
$(printf '  %s\n' $bad_files)
  Real values live only in the dev box's .env and on the VM.
  Unstage with:  git restore --staged <file>

MSG
    exit 1
  fi

  # 1b. High-signal secret formats in added lines. The hooks and
  # .env.example (placeholders only) are excluded from the scan.
  secret_re='sk-ant-[A-Za-z0-9_-]{8,}'                      # Anthropic
  secret_re="$secret_re|sk_(live|test)_[A-Za-z0-9]{16,}"    # Stripe
  secret_re="$secret_re|AKIA[0-9A-Z]{16}"                   # AWS access key
  secret_re="$secret_re|AIza[0-9A-Za-z_-]{35}"              # Google API key
  secret_re="$secret_re|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}"
  secret_re="$secret_re|xox[baprs]-[A-Za-z0-9-]{10,}"       # Slack
  secret_re="$secret_re|re_[A-Za-z0-9]{20,}"                # Resend
  secret_re="$secret_re|SK[a-f0-9]{32}"                     # Twilio API key
  secret_re="$secret_re|-----BEGIN [A-Z ]*PRIVATE KEY"
  # Generic literal assignment to a secret-named variable…
  generic_re='(API[_-]?KEY|SECRET|PASSWORD|TOKEN|PASSWD|PWD)[A-Z_]*[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}'
  # …minus obvious placeholders/env indirection.
  placeholder_re='<[^>]*>|\$\{|\bprocess\.env\b|xxx+|change-?me|example|placeholder|your[_-]|dummy|redacted'

  added=$(git diff --cached --unified=0 --no-color -- . \
            ':(exclude)scripts/git-hooks' ':(exclude).env.example' \
          | grep -E '^\+' | grep -vE '^\+\+\+')
  hits=$( { printf '%s\n' "$added" | grep -E  "$secret_re"; \
            printf '%s\n' "$added" | grep -iE "$generic_re" | grep -ivE "$placeholder_re"; } \
          | sort -u )
  if [ -n "$hits" ]; then
    cat >&2 <<MSG

BLOCKED: secrets gate — staged additions look like API keys or passwords:
$(printf '%s\n' "$hits" | head -10 | cut -c1-120 | sed 's/^/  /')
  Move the value to .env (gitignored) and read it from the environment.
  If this is a FALSE POSITIVE only:  SECRETS_OK=1 git commit ...
  If a real secret was ever committed, rotate it immediately.

MSG
    exit 1
  fi
fi

# 2. JSX glued-text gate: a text node carrying BOTH a newline and an HTML entity
# silently loses the space separating it from whatever precedes it, so a link and
# the next word ship joined ("Follow-Up Emailslands"). Shipped twice; the fix is an
# explicit {" "} at the boundary. Rule and evidence: scripts/check-jsx-spacing.mjs.
#
# The scanner reads STAGED blobs, not the worktree, so `git add -p` and
# stage-then-keep-editing cannot slip a defect past the gate. It exits 1 for a
# finding and 2 when the check itself cannot run; both block, but only 1 is
# bypassable, because a check that did not run is not a clean check.
#
# Bypass (false positive in the scan ONLY):  JSX_SPACING_OK=1 git commit ...
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.tsx$'; then
  if [ ! -r scripts/check-jsx-spacing.mjs ]; then
    echo "BLOCKED: scripts/check-jsx-spacing.mjs is missing — the jsx-spacing gate" >&2
    echo "  cannot run, and a gate that did not run is not a pass. Restore it." >&2
    exit 1
  fi
  node scripts/check-jsx-spacing.mjs --staged >&2
  jsx_status=$?
  if [ "$jsx_status" -eq 2 ]; then
    echo "BLOCKED: the jsx-spacing check could not run (node missing or script error)." >&2
    echo "  This gate fails closed. Fix the check rather than bypassing it." >&2
    exit 1
  fi
  if [ "$jsx_status" -ne 0 ] && [ -z "${JSX_SPACING_OK:-}" ]; then
    echo "  Bypass for a false positive only:  JSX_SPACING_OK=1 git commit ..." >&2
    exit 1
  fi
fi

# Roadmap caching gate (§5.18, 2026-08-04): company-private pages must stay
# force-dynamic, unindexed, and revalidation-free. Structural leak class, so
# it fails closed like the jsx gate.
if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^src/app/(roadmap|admin/roadmap|api/roadmap|sitemap)'; then
  if [ ! -r scripts/check-roadmap-caching.mjs ]; then
    echo "BLOCKED: scripts/check-roadmap-caching.mjs is missing — the roadmap caching gate" >&2
    echo "  cannot run, and a gate that did not run is not a pass. Restore it." >&2
    exit 1
  fi
  if ! node scripts/check-roadmap-caching.mjs >&2; then
    echo "BLOCKED: roadmap caching gate (see above)." >&2
    exit 1
  fi
fi

# ── Person-mapping seed gate (§5.16/§5.18 + §5.21, 2026-08-29) ────────────
# work_static_credits (who built which /work exhibit) and chase_tasks /
# chase_sends (who was asked for what and has not done it) both map a
# colleague BY ADDRESS to a fact about them. THIS REPOSITORY IS PUBLIC, so
# those rows live only in the production database and their migrations create
# EMPTY structure; the rows are written on the VM.
#
# Until now that rule was prose in three comments, and the existing secrets
# gate above does not match an email address, so the obvious next step for a
# future session ("just add the two missing credits") would have committed a
# seed with nothing objecting. This gate is the fail-closed half: reject any
# staged ADDED line that names one of those tables and also carries an "@".
# It is a names-and-formats check like the secrets gate, not a parser: it
# stops the obvious seed, not a determined one split across lines.
#
# The address test is an EMAIL SHAPE (local part, @, dotted domain, TLD), not
# a bare "@": the first cut used "@" and fired on a documentation line that
# merely named the table next to `@aicompany/core` (2026-08-29, a real false
# positive on a peer's commit that cost them a bypass). A package scope, a
# decorator or an at-mention must not trip a gate whose whole value is that
# people trust it enough not to reach for the bypass.
seed_hits=$(git diff --cached --unified=0 --diff-filter=ACMR -- . \
  | grep -E '^\+' \
  | grep -Ev '^\+\+\+' \
  | grep -E 'work_static_credits|chase_tasks|chase_sends' \
  | grep -E '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\.[A-Za-z]{2,}' || true)
if [ -n "$seed_hits" ]; then
  echo "BLOCKED: a staged line names a person-mapping table and contains an email address:" >&2
  echo "$seed_hits" | head -5 >&2
  echo "  These tables map a colleague by address to a fact about them, and this repo is" >&2
  echo "  PUBLIC: a committed seed publishes that permanently, and git history keeps it" >&2
  echo "  after any revert. Migrations create EMPTY structure; rows are written on the VM" >&2
  echo "  (npm run work:credit, npm run chase:seed). See the migration headers." >&2
  echo "  Bypass ONLY for a false positive (a comment, a test with a fake domain):" >&2
  echo "    PERSON_MAP_OK=1 git commit ..." >&2
  [ -n "${PERSON_MAP_OK:-}" ] || exit 1
fi

exit 0
