{
  "model": "claude-fable-5[1m]",
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git push origin master*)",
      "Bash(gcloud compute instances add-metadata:*)",
      "Bash(gcloud compute scp:*)",
      "Bash(gcloud compute ssh:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lakehouse-checkpoint.mjs --hook stop || true",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lakehouse-checkpoint.mjs --hook session-start || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
